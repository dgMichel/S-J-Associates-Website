---
import Layout from "../layouts/Layout.astro";
import { cars } from "../data/cars";
const carsJson = JSON.stringify(cars.map(c => ({
  slug: c.slug,
  brand: c.brand,
  model: c.model,
  color: c.color,
  plate: c.plate,
  pricePerDay: c.pricePerDay,
})));
---

<Layout>
  <main class="admin-page">
    <div class="admin-container">
      <div class="admin-header">
        <a href="/" class="back-link">&larr; Back to site</a>
        <div class="header-row">
          <div>
            <h1>Admin Panel</h1>
            <p class="subtitle">Manage car prices and availability</p>
          </div>
          <button id="logoutBtn" class="header-logout">Log out</button>
        </div>
      </div>

      <div class="admin-card">
        <h2>Car Prices</h2>
        <p class="field-desc">
          Update the daily rental price for each vehicle. Changes apply across the
          site immediately for this browser.
        </p>

        <div id="carsTable" class="cars-table">
          <div class="cars-loading">Loading cars...</div>
        </div>
        <p id="carsMsg" class="save-msg" style="display:none"></p>
      </div>

      <div class="admin-card" id="availabilityCard">
        <h2>Availability</h2>
        <p class="field-desc">Mark dates as unavailable for each vehicle.</p>

        <div id="availabilityList" class="availability-list">
          <div class="cars-loading">Loading cars...</div>
        </div>
      </div>
    </div>
  </main>

  <div id="toast" class="toast" style="display:none"></div>

  <script id="carsData" type="application/json" set:html={carsJson}></script>
</Layout>

<script>
  import { getOverridePrice, setPriceOverride, dispatchPricesChanged } from "../lib/prices";

  (() => {
    type CarRow = { slug: string; brand: string; model: string; color: string; plate: string; pricePerDay: number };
    type Unavailable = { id: number; date: string; reason: string | null };

    const tokenPayload = (() => {
      try { return JSON.parse(atob((localStorage.getItem("access_token") || "").split(".")[1])); }
      catch { return null; }
    })();
    const userRole = tokenPayload?.app_metadata?.role || tokenPayload?.role;
    if (!tokenPayload || userRole !== "admin") {
      const main = document.querySelector("main") as HTMLElement;
      main.innerHTML = `<div style="min-height:80vh;display:flex;align-items:center;justify-content:center"><div style="text-align:center;max-width:400px"><h1 style="font-size:24px;font-weight:700;color:#0f172a;margin-bottom:8px">Access Denied</h1><p style="color:#64748b;margin-bottom:24px">You need admin privileges to access this page.</p><a href="/" style="display:inline-block;padding:12px 28px;background:#0f172a;color:white;border-radius:10px;font-weight:600;text-decoration:none">Go Home</a></div></div>`;
      return;
    }

    const carList = JSON.parse(document.getElementById("carsData")?.textContent || "[]") as CarRow[];

    const backendBase = () => {
      const full = localStorage.getItem("backend_url") || "";
      return full.replace(/\/payments\/create-checkout-session$/, "").replace(/\/$/, "") || "http://localhost:8000/api/v1";
    };

    const toast = (() => {
      const el = document.getElementById("toast") as HTMLDivElement;
      let timer: number | undefined;
      return (msg: string, kind: "ok" | "err" = "ok") => {
        el.textContent = msg;
        el.className = `toast toast--${kind}`;
        el.style.display = "block";
        if (timer) window.clearTimeout(timer);
        timer = window.setTimeout(() => { el.style.display = "none"; }, 3000);
      };
    })();

    const forceLogout = () => {
      localStorage.removeItem("access_token");
      localStorage.removeItem("username");
      localStorage.removeItem("user_role");
      toast("Session expired. Please log in again.", "err");
      setTimeout(() => { window.location.href = "/"; }, 1500);
    };

    document.getElementById("logoutBtn")?.addEventListener("click", forceLogout);

    async function authedFetch(url: string, init: RequestInit = {}): Promise<Response> {
      const token = localStorage.getItem("access_token") || "";
      const headers = new Headers(init.headers || {});
      headers.set("Authorization", `Bearer ${token}`);
      if (init.body && !headers.has("Content-Type")) headers.set("Content-Type", "application/json");
      const res = await fetch(url, { ...init, headers });
      if (res.status === 401) {
        forceLogout();
        throw new Error("unauthorized");
      }
      return res;
    }

    function renderPrices() {
      const table = document.getElementById("carsTable") as HTMLDivElement;
      const msg = document.getElementById("carsMsg") as HTMLParagraphElement;

      table.innerHTML = `<div class="cars-header prices-header">
          <span class="car-cell car-cell--wide">Car</span>
          <span class="car-cell price-col">Base price</span>
          <span class="car-cell price-col">Current price</span>
          <span class="car-cell car-cell--action"></span>
        </div>` +
        carList.map((c) => {
          const current = getOverridePrice(c.slug, c.pricePerDay);
          const changed = current !== c.pricePerDay;
          return `<div class="car-row" data-slug="${c.slug}">
            <span class="car-cell car-cell--wide">${c.brand} ${c.model} — ${c.color} (${c.plate})</span>
            <span class="car-cell price-col">EC$ ${c.pricePerDay}</span>
            <span class="car-cell price-col"><input type="number" class="price-input" min="0" step="1" value="${current}" /></span>
            <span class="car-cell car-cell--action">
              <button class="car-save-btn">Save</button>
              ${changed ? `<button class="car-reset-btn" title="Reset to base price">Reset</button>` : ""}
            </span>
          </div>`;
        }).join("");

      table.querySelectorAll<HTMLButtonElement>(".car-save-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const row = btn.closest(".car-row") as HTMLElement;
          const slug = row.dataset.slug!;
          const input = row.querySelector(".price-input") as HTMLInputElement;
          const price = parseFloat(input.value);
          if (Number.isNaN(price) || price < 0) {
            toast("Invalid price", "err");
            return;
          }
          setPriceOverride(slug, price);
          dispatchPricesChanged();
          msg.textContent = "Price updated!";
          msg.style.color = "#16a34a";
          msg.style.display = "block";
          setTimeout(() => { msg.style.display = "none"; }, 2500);
          renderPrices();
        });
      });

      table.querySelectorAll<HTMLButtonElement>(".car-reset-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const row = btn.closest(".car-row") as HTMLElement;
          const slug = row.dataset.slug!;
          setPriceOverride(slug, carList.find(c => c.slug === slug)!.pricePerDay);
          dispatchPricesChanged();
          renderPrices();
        });
      });
    }

    function todayISO(): string {
      const d = new Date();
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
    }

    function formatLongDate(iso: string): string {
      const [y, m, d] = iso.split("-").map(Number);
      const date = new Date(y, m - 1, d);
      return date.toLocaleDateString(undefined, { weekday: "short", year: "numeric", month: "short", day: "numeric" });
    }

    function expandRange(start: string, end: string): string[] {
      const [sy, sm, sd] = start.split("-").map(Number);
      const [ey, em, ed] = end.split("-").map(Number);
      const s = new Date(sy, sm - 1, sd);
      const e = new Date(ey, em - 1, ed);
      if (e < s) return [];
      const out: string[] = [];
      const cur = new Date(s);
      while (cur <= e) {
        const y = cur.getFullYear();
        const m = String(cur.getMonth() + 1).padStart(2, "0");
        const d = String(cur.getDate()).padStart(2, "0");
        out.push(`${y}-${m}-${d}`);
        cur.setDate(cur.getDate() + 1);
      }
      return out;
    }

    async function loadAvailability(slug: string): Promise<Unavailable[]> {
      const res = await fetch(`${backendBase()}/cars/${slug}/unavailable`);
      if (res.status === 401) {
        forceLogout();
        throw new Error("unauthorized");
      }
      const data = await res.json();
      return Array.isArray(data) ? data : [];
    }

    function renderAvailabilityCard(car: CarRow, list: Unavailable[]) {
      const sorted = [...list].sort((a, b) => a.date.localeCompare(b.date));
      const chips = sorted.length
        ? sorted.map((d) => `
            <span class="date-chip" data-date="${d.date}" data-id="${d.id}">
              <span class="date-chip__label">${d.date}</span>
              <span class="date-chip__sub">${formatLongDate(d.date)}</span>
              <button type="button" class="date-chip__remove" aria-label="Remove ${d.date}">×</button>
            </span>
          `).join("")
        : `<p class="empty-state">No unavailable dates yet.</p>`;

      return `
        <div class="avail-card" data-slug="${car.slug}">
          <div class="avail-card__head">
            <div>
              <h3>${car.brand} ${car.model} — ${car.color}</h3>
              <span class="plate-tag">${car.plate}</span>
            </div>
            <span class="avail-count">${sorted.length} blocked</span>
          </div>

          <div class="mode-switch" role="tablist">
            <button type="button" class="mode-btn is-active" data-mode="single">Single</button>
            <button type="button" class="mode-btn" data-mode="range">Range</button>
          </div>

          <div class="avail-card__add avail-card__add--single">
            <input type="date" class="avail-date" min="${todayISO()}" value="${todayISO()}" />
            <button type="button" class="avail-add-btn avail-add-single">Mark unavailable</button>
          </div>

          <div class="avail-card__add avail-card__add--range" style="display:none">
            <input type="date" class="avail-range-start" min="${todayISO()}" value="${todayISO()}" />
            <span class="range-sep">→</span>
            <input type="date" class="avail-range-end" min="${todayISO()}" value="${todayISO()}" />
            <span class="range-days"></span>
          </div>
          <div class="avail-card__add avail-card__add--range" style="display:none">
            <button type="button" class="avail-add-btn avail-add-range-block">Block range</button>
            <button type="button" class="avail-add-btn avail-add-range-unblock">Unblock range</button>
          </div>

          <div class="avail-card__list">
            ${chips}
          </div>
        </div>
      `;
    }

    async function renderAvailability() {
      const root = document.getElementById("availabilityList") as HTMLDivElement;
      root.innerHTML = "";

      for (const car of carList) {
        const wrapper = document.createElement("div");
        wrapper.innerHTML = `<div class="cars-loading">Loading ${car.brand} ${car.model}…</div>`;
        root.appendChild(wrapper);
        try {
          const list = await loadAvailability(car.slug);
          wrapper.innerHTML = renderAvailabilityCard(car, list);
          wireAvailabilityCard(wrapper, car.slug);
        } catch (e: any) {
          if (e?.message !== "unauthorized") {
            wrapper.innerHTML = `<p style="color:#dc2626;font-size:13px;padding:12px">Could not load availability.</p>`;
          }
        }
      }
    }

    function updateRangeDays(scope: HTMLElement) {
      const start = scope.querySelector<HTMLInputElement>(".avail-range-start");
      const end = scope.querySelector<HTMLInputElement>(".avail-range-end");
      const label = scope.querySelector<HTMLElement>(".range-days");
      if (!start || !end || !label) return;
      const days = expandRange(start.value, end.value).length;
      if (days <= 0) {
        label.textContent = "invalid";
        label.className = "range-days range-days--invalid";
      } else if (days === 1) {
        label.textContent = "1 day";
        label.className = "range-days";
      } else {
        label.textContent = `${days} days`;
        label.className = "range-days";
      }
    }

    function wireAvailabilityCard(scope: HTMLElement, slug: string) {
      const modeBtns = scope.querySelectorAll<HTMLButtonElement>(".mode-btn");
      const singleBox = scope.querySelector<HTMLElement>(".avail-card__add--single")!;
      const rangeBoxes = scope.querySelectorAll<HTMLElement>(".avail-card__add--range");

      modeBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const mode = btn.dataset.mode;
          modeBtns.forEach((b) => b.classList.toggle("is-active", b === btn));
          singleBox.style.display = mode === "single" ? "flex" : "none";
          rangeBoxes.forEach((b) => (b.style.display = mode === "range" ? "flex" : "none"));
        });
      });

      const startEl = scope.querySelector<HTMLInputElement>(".avail-range-start");
      const endEl = scope.querySelector<HTMLInputElement>(".avail-range-end");
      startEl?.addEventListener("change", () => {
        if (endEl && endEl.value < startEl.value) endEl.value = startEl.value;
        updateRangeDays(scope);
      });
      endEl?.addEventListener("change", () => {
        if (startEl && startEl.value > endEl.value) startEl.value = endEl.value;
        updateRangeDays(scope);
      });
      updateRangeDays(scope);

      const singleBtn = scope.querySelector<HTMLButtonElement>(".avail-add-single");
      const singleInput = scope.querySelector<HTMLInputElement>(".avail-date");
      singleBtn?.addEventListener("click", async () => {
        const date = singleInput?.value;
        if (!date) return;
        await runAction(slug, async () => {
          const res = await authedFetch(`${backendBase()}/cars/${slug}/unavailable`, {
            method: "POST",
            body: JSON.stringify({ date }),
          });
          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            throw new Error(err.detail || `HTTP ${res.status}`);
          }
          toast("Date marked unavailable");
          await refreshCard(slug);
        });
      });

      const blockRangeBtn = scope.querySelector<HTMLButtonElement>(".avail-add-range-block");
      blockRangeBtn?.addEventListener("click", async () => {
        const start = startEl?.value;
        const end = endEl?.value;
        if (!start || !end) return;
        const days = expandRange(start, end).length;
        if (days <= 0) {
          toast("Invalid range", "err");
          return;
        }
        if (!confirm(`Block ${days} day(s) from ${start} to ${end}?`)) return;
        await runAction(slug, async () => {
          const res = await authedFetch(`${backendBase()}/cars/${slug}/unavailable/range`, {
            method: "POST",
            body: JSON.stringify({ start, end }),
          });
          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            throw new Error(err.detail || `HTTP ${res.status}`);
          }
          toast(`Blocked ${days} day(s)`);
          await refreshCard(slug);
        });
      });

      const unblockRangeBtn = scope.querySelector<HTMLButtonElement>(".avail-add-range-unblock");
      unblockRangeBtn?.addEventListener("click", async () => {
        const start = startEl?.value;
        const end = endEl?.value;
        if (!start || !end) return;
        const days = expandRange(start, end).length;
        if (days <= 0) {
          toast("Invalid range", "err");
          return;
        }
        if (!confirm(`Unblock ${days} day(s) from ${start} to ${end}?`)) return;
        await runAction(slug, async () => {
          const url = `${backendBase()}/cars/${slug}/unavailable/range?start=${start}&end=${end}`;
          const res = await authedFetch(url, { method: "DELETE" });
          if (!res.ok && res.status !== 204) {
            const err = await res.json().catch(() => ({}));
            throw new Error(err.detail || `HTTP ${res.status}`);
          }
          toast(`Unblocked ${days} day(s)`);
          await refreshCard(slug);
        });
      });

      scope.querySelectorAll<HTMLButtonElement>(".date-chip__remove").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const chip = btn.closest(".date-chip") as HTMLElement;
          const date = chip.dataset.date!;
          try {
            const res = await authedFetch(`${backendBase()}/cars/${slug}/unavailable/${date}`, {
              method: "DELETE",
            });
            if (!res.ok && res.status !== 204) throw new Error(`HTTP ${res.status}`);
            chip.style.opacity = "0";
            chip.style.transform = "scale(0.9)";
            setTimeout(() => refreshCard(slug), 200);
            toast("Date is now available");
          } catch (e: any) {
            if (e?.message !== "unauthorized") toast(e.message || "Failed", "err");
          }
        });
      });
    }

    async function runAction(_slug: string, fn: () => Promise<void>) {
      try {
        await fn();
      } catch (e: any) {
        if (e?.message !== "unauthorized") toast(e.message || "Failed", "err");
      }
    }

    async function refreshCard(slug: string) {
      const card = document.querySelector<HTMLElement>(`.avail-card[data-slug="${slug}"]`);
      if (!card) return;
      const car = carList.find(c => c.slug === slug)!;
      const list = await loadAvailability(slug);
      card.outerHTML = renderAvailabilityCard(car, list);
      const fresh = document.querySelector<HTMLElement>(`.avail-card[data-slug="${slug}"]`);
      if (fresh) wireAvailabilityCard(fresh, slug);
    }

    renderPrices();
    renderAvailability();
  })();
</script>

<style>
  .admin-page {
    min-height: 100vh;
    padding: 48px 24px;
  }

  .admin-container {
    max-width: 760px;
    margin: 0 auto;
  }

  .admin-header {
    margin-bottom: 40px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    font-weight: 500;
    color: #64748b;
    margin-bottom: 24px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: #0f172a;
  }

  .header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .admin-header h1 {
    font-size: 32px;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 6px;
  }

  .subtitle {
    font-size: 15px;
    color: #64748b;
  }

  .header-logout {
    background: transparent;
    border: 1px solid #e2e8f0;
    color: #475569;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
  }

  .header-logout:hover {
    background: #fef2f2;
    border-color: #fecaca;
    color: #dc2626;
  }

  .admin-card {
    background: white;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 16px;
    padding: 32px;
    margin-bottom: 24px;
  }

  .admin-card h2 {
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 12px;
    color: #0f172a;
  }

  .field-desc {
    font-size: 14px;
    color: #64748b;
    margin-bottom: 24px;
    line-height: 1.6;
  }

  .save-msg {
    text-align: center;
    margin-top: 12px;
    font-size: 14px;
    font-weight: 500;
  }

  .cars-table {
    background: #f8fafc;
    border-radius: 10px;
    overflow: hidden;
  }

  .cars-loading {
    padding: 24px;
    text-align: center;
    font-size: 14px;
    color: #94a3b8;
  }

  .cars-header,
  .car-row {
    display: grid;
    grid-template-columns: 1fr 90px 110px auto;
    gap: 8px;
    align-items: center;
    padding: 12px 16px;
    font-size: 14px;
  }

  .cars-header {
    font-weight: 600;
    color: #64748b;
    background: #f1f5f9;
    border-bottom: 1px solid #e2e8f0;
  }

  .car-row {
    border-bottom: 1px solid #e2e8f0;
  }

  .car-row:last-child {
    border-bottom: none;
  }

  .car-cell {
    color: #0f172a;
  }

  .car-cell--wide {
    font-weight: 500;
  }

  .car-cell--action {
    text-align: right;
  }

  .price-col {
    color: #475569;
    font-variant-numeric: tabular-nums;
  }

  .prices-header .price-col {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .price-input {
    width: 90px;
    padding: 6px 10px;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
  }

  .price-input:focus {
    border-color: #0f172a;
  }

  .car-save-btn,
  .car-reset-btn {
    padding: 6px 12px;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    margin-left: 4px;
  }

  .car-save-btn {
    background: #0f172a;
  }

  .car-save-btn:hover {
    background: #1e293b;
  }

  .car-save-btn:disabled {
    background: #94a3b8;
    cursor: not-allowed;
  }

  .car-reset-btn {
    background: #94a3b8;
  }

  .car-reset-btn:hover {
    background: #64748b;
  }

  .availability-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .avail-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 18px 20px;
    transition: border-color 0.2s;
  }

  .avail-card:hover {
    border-color: #cbd5e1;
  }

  .avail-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .avail-card__head h3 {
    font-size: 15px;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 2px;
  }

  .plate-tag {
    font-size: 12px;
    color: #94a3b8;
    font-weight: 500;
  }

  .avail-count {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 600;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .avail-card__add {
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
  }

  .avail-card__add--range {
    align-items: center;
  }

  .mode-switch {
    display: inline-flex;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 3px;
    margin-bottom: 12px;
  }

  .mode-btn {
    padding: 6px 14px;
    background: transparent;
    border: none;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s;
  }

  .mode-btn:hover {
    color: #0f172a;
  }

  .mode-btn.is-active {
    background: #0f172a;
    color: white;
  }

  .range-sep {
    color: #94a3b8;
    font-weight: 600;
    font-size: 14px;
    padding: 0 4px;
  }

  .range-days {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 600;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }

  .range-days--invalid {
    color: #dc2626;
    border-color: #fecaca;
    background: #fef2f2;
