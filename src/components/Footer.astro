---
import logoSvg from "../assets/file-1.svg";
import { Image } from "astro:assets";
import { SITE } from "../consts";
const phone = import.meta.env.PHONE || SITE.phone;
const email = import.meta.env.EMAIL || SITE.email;
const mapsUrl = SITE.mapsUrl;
---

<footer id="contact" role="contentinfo" itemscope itemtype="https://schema.org/AutoRental">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo" aria-label="5J & Associates - Home">
          <Image
            src={logoSvg}
            alt="5J & Associates - Car rental in Grenada"
            width="300"
            height="300"
            loading="eager"
            fetchpriority="high"
          />
        </a>

        <div class="footer-brand-text">
          <h3 itemprop="name">5J & Associates</h3>
          <p itemprop="description">
            Your trusted partner for reliable car rental services in Grenada. Suzuki Ignis and Nissan Cube rentals from EC$150 per day.
          </p>
        </div>
      </div>

      <nav class="footer-links" aria-label="Fleet navigation">
        <h4>Our Fleet</h4>
        <a href="/#suzuki">Suzuki Ignis Rentals</a>
        <a href="/#nissan">Nissan Cube Rentals</a>
        <a href="/#faq">FAQs</a>
      </nav>

      <div class="footer-contact" itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
        <h4>Contact</h4>
        <p>
          <strong>Hours:</strong>
          <span>Open 24/7 — every day</span>
        </p>
        <p>
          <strong>Location:</strong>
          <a
            href={SITE.mapsUrl}
            target="_blank"
            rel="noreferrer noopener"
            itemprop="addressLocality"
          >
            <span>St. George's</span>, <span itemprop="addressCountry">Grenada</span> ↗
          </a>
        </p>
        <p>
          <strong>Email:</strong>
          <a href={`mailto:${email}`} itemprop="email">{email}</a>
        </p>
        <p>
          <strong>Phone:</strong>
          <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} itemprop="telephone">{phone}</a>
        </p>
        <p>
          <a
            class="whatsapp-btn"
            href="https://wa.me/14734046549?text=Hello%20I%20would%20like%20to%20book%20a%20car%20rental%20in%20Grenada"
            target="_blank"
            rel="noreferrer noopener"
            aria-label="Contact us on WhatsApp"
          >
            Book via WhatsApp
          </a>
        </p>
      </div>
    </div>
    <div class="footer-bottom">
      <p>
        &copy; {new Date().getFullYear()} 5J & Associates. All rights reserved. | Car rental in St. George's, Grenada.
      </p>
    </div>
  </div>
</footer>

<style>
  
  footer {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
    color: white;
    padding: 72px 0 32px;
  }
  .footer-brand {
  display: flex;
  align-items: center;
  gap: 20px;
}

.footer-brand-text {
  display: flex;
  flex-direction: column;
}

.footer-brand-text h3 {
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.3px;
  margin: 0 0 10px;
}

.footer-brand-text p {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.7;
  margin: 0;
  max-width: 260px;
}

.logo {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.logo img {
  width: 140px;
  height: 140px;
  object-fit: contain;
  border-radius: 50%;
}
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
    padding: 0 24px;
  }
  .footer-links h4,
  .footer-contact h4,
  .footer-hours h4 {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: rgba(255, 255, 255, 0.35);
    margin-bottom: 20px;
  }

  .footer-links a {
    display: block;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 12px;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: white;
  }

  .footer-contact p,
  .footer-hours p {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 8px;
  }

  .footer-contact a {
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.2s;
  }

  .footer-contact a:hover {
    color: white;
  }

  .footer-contact p strong {
    color: rgba(255, 255, 255, 0.4);
    font-weight: 600;
    margin-right: 6px;
  }

  .footer-contact p span {
    color: rgba(255, 255, 255, 0.85);
  }

  .whatsapp-btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 14px;
    border-radius: 999px;
    background-color: #25d366;
    color: #0f172a;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s, background-color 0.2s;
  }

  .whatsapp-btn:hover {
    transform: translateY(-1px);
    background-color: #22c65b;
  }

  .footer-bottom {
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    text-align: center;
    padding-left: 24px;
    padding-right: 24px;
  }

  .footer-bottom p {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.35);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
